# ============================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# ============================================
# Copy this file and fill in real values before deploying
# NEVER commit this file with real secrets to git!

# Database
DB_USER=tnp_admin
DB_PASSWORD=CHANGE_THIS_STRONG_PASSWORD
DB_NAME=tnp_portal

# Application Secrets
JWT_SECRET=CHANGE_THIS_GENERATE_WITH_openssl_rand_hex_64
NEXTAUTH_SECRET=CHANGE_THIS_GENERATE_WITH_openssl_rand_hex_64

# Portal URL (your college domain)
NEXTAUTH_URL=http://tnp.nitap.ac.in

# Email Configuration (for verification emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=placement@nitap.ac.in
SMTP_PASSWORD=CHANGE_THIS_APP_PASSWORD
EMAIL_FROM=placement@nitap.ac.in
